{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "hot-reload: ensure X-Plane running",
      "type": "shell",
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/ensure-xplane-running.ps1"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/ensure-xplane-running.sh"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/ensure-xplane-running.sh"]
      },
      "presentation": {
        "reveal": "silent",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "hot-reload: install loader",
      "type": "shell",
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/install-loader.ps1"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/install-loader.sh"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/install-loader.sh"]
      },
      "dependsOn": ["hot-reload: ensure X-Plane running"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "hot-reload: build payload",
      "type": "shell",
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build-payload.ps1"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/build-payload.sh"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/build-payload.sh"]
      },
      "dependsOn": ["hot-reload: install loader"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
